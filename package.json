    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/host-grotesk": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
