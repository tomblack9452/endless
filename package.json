{
  "name": "endless",
  "version": "1.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "biome check . && tsc --noEmit && vitest run && vite build",
    "db:setup": "node scripts/build-setup-sql.mjs",
    "check-server": "node scripts/check-server.mjs",
    "db:apply": "node scripts/apply-db.mjs",
    "names:build": "node scripts/name-filter/build.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.5.12",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/host-grotesk": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.56.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
