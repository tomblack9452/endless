# Copy to .env and fill in to turn on the server and the store (see docs/leaderboards.md).
# Without these the game runs entirely on the device.
#
# Supabase: Project settings > API. Use the "anon" public key, never service_role.
# `npm run check-server` tells you if anything is missing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only for `npm run db:apply` (sets up the database from your terminal). A secret, and not a VITE_
# variable, so it is never put in the game's build. Dashboard > Connect > Session pooler.
SUPABASE_DB_URL=
VITE_REVENUECAT_APPLE_KEY=
VITE_REVENUECAT_GOOGLE_KEY=
# AdMob ad unit ids for the apps (none on the web). Without them there are no ads.
# Every build shows Google's TEST ads (safe to tap) until this is 1. Set it to 1
# only for the build you upload for release, never while testing on your phone.
VITE_ADMOB_LIVE=
VITE_ADMOB_REWARDED_IOS=
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_INTERSTITIAL_IOS=
VITE_ADMOB_INTERSTITIAL_ANDROID=
