# Copy to .env and fill in to turn on the server and the store (see docs/leaderboards.md
# and docs/store.md). Without these the game runs entirely on the device. .env is never
# committed. Every VITE_ value is baked into the build: change one, then rebuild
# (npm run build) and, for the app, npx cap sync android.
#
# Supabase: Project Settings > API Keys: the project URL and the publishable key
# (sb_publishable_..., or the legacy "anon" key). Never the secret or service_role key.
# `npm run check-server` tells you if anything is missing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only for `npm run db:apply` (sets up the database from your terminal). A secret, and not a VITE_
# variable, so it is never put in the game's build. Dashboard > Connect > Session pooler.
SUPABASE_DB_URL=
# Google sign-in (keeping an account; Android app only): the WEB application OAuth
# client id from Google Cloud (not the Android one). See docs/store.md, "Google sign-in".
VITE_GOOGLE_WEB_CLIENT_ID=
# RevenueCat: the project's API keys page: the public SDK key for each app (appl_... for
# iOS, goog_... for Android). The webhook's secret is not here: it's a Supabase function
# secret (REVENUECAT_WEBHOOK_SECRET, see docs/store.md).
VITE_REVENUECAT_APPLE_KEY=
VITE_REVENUECAT_GOOGLE_KEY=
# AdMob ad unit ids for the apps (none on the web). Without them there are no ads.
# Every build shows Google's TEST ads (safe to tap) until this is 1. Set it to 1
# only for the build you upload for release, never while testing on your phone.
VITE_ADMOB_LIVE=
VITE_ADMOB_REWARDED_IOS=
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_INTERSTITIAL_IOS=
VITE_ADMOB_INTERSTITIAL_ANDROID=
